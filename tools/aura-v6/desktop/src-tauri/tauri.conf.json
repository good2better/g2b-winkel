{
  "build": {
    "distDir": "../../",
    "devPath": "http://localhost:8300",
    "beforeBuildCommand": "",
    "beforeDevCommand": ""
  },
  "package": {
    "productName": "G2B AURA v6.0",
    "version": "6.0.0"
  },
  "tauri": {
    "windows": [
      {
        "title": "G2B AURA v6.0 Master Studio",
        "width": 1400,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' http://localhost:8300; media-src 'self' blob:; worker-src 'self' blob:"
    },
    "bundle": {
      "active": true,
      "identifier": "com.good2better.aura",
      "icon": [
        "icons/icon.png",
        "icons/icon.ico",
        "icons/icon.icns"
      ]
    }
  }
}